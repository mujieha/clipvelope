.DS_Store
/.build
/.swiftpm
/DerivedData

# Personal Claude Code permission overrides
.claude/settings.local.json

# JetBrains IDE
.idea/
dist/

# Generated by `make icon`; the .icns is committed.
AppIcon.iconset/

# Generated by `make xcodeproj`; it embeds a specific DEVELOPMENT_TEAM.
Clipvelope.xcodeproj/

# Tied to one developer account, and short-lived. Obtain your own; see docs/SIGNING.md.
Resources/embedded.provisionprofile

# Build and test residue
*.profdata
*.xcresult
/coverage
*.log

# Editors and tooling state
.vscode/
.claude/
CLAUDE.md
.remember/

# Anything that could be a credential or a key. Signing identities live in the
# Keychain, the Sparkle key is exported only to a backup outside the repository.
*.p12
*.cer
*.pem
*.key
*.provisionprofile
*.mobileprovision
.env
.env.*

# Vault backups and images, which hold clipboard history
*.cvb
*.cvi
